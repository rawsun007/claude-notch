# Swift / SwiftPM build artifacts
.build/
.build-x86_64/
.swiftpm/
Package.resolved
*.xcodeproj/
DerivedData/

# Built .app bundle (regenerate via ./build.sh)
ClaudeNotch.app/

# Distributable artifacts (regenerate via tools/build-dmg.sh)
dist/
ClaudeNotch.dmg
assets/AppIcon.iconset/

# macOS junk
.DS_Store

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# Local Claude Code project state
.claude/settings.local.json

# Local debug + hook logs (runtime artifacts)
/tmp/claudenotch-*.log
claudenotch-*.log

# Xcode per-user state, not project configuration
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/

# Promo videos: the source lives in promo/, the renders do not.
# Scratch output from the /brag skill (timestamped folders per run).
brag-output/
brag-output-*/
# Per-video render artefacts, all regenerated by promo/*/build.sh
promo/*/frames/
promo/*/clips/
promo/*/stills/
promo/*/node_modules/
promo/*/page.html
promo/*/icon.png
promo/*/score.wav
promo/*/out/
